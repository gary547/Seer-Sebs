    "sync:gcp-identity-profiles": "node gcp/scripts/sync-identity-profiles.mjs",
    "check:gcp-boundary": "node scripts/check-gcp-boundary.mjs",
    "check:router-boundary": "node scripts/check-router-boundary.mjs",
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:categorisation:sql": "bash scripts/test-categorisation-sql.sh",
    "test:gcp": "vitest run --config vitest.gcp.config.ts",
    "test:gcp-database-transfer": "bash gcp/scripts/test-database-archive-transfer.sh",
    "test:gcp-database-canonical": "npm run build:gcp && bash gcp/scripts/test-database-canonical-transfer.sh",
    "test:gcp-backup-restore": "bash gcp/scripts/test-backup-restore.sh",
    "test:gcp-database-access": "bash gcp/scripts/test-database-access-boundaries.sh",
    "test:gcp-url-monitor-maintenance": "node gcp/scripts/test-url-monitor-maintenance.mjs",
    "test:gcp:docker": "bash gcp/scripts/validate-docker.sh",
    "test:gcp:fresh-schema": "bash gcp/scripts/validate-fresh-schema.sh",
    "test:gcp:scale": "node gcp/scripts/validate-scale.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.app.json",
    "typecheck:gcp": "tsc -p tsconfig.gcp.json",
    "validate:foundation": "npm run check:router-boundary && npm run typecheck && npm test && npm run build && npm run validate:gcp",
    "validate:gcp": "npm run check:gcp-boundary && npm run check:gcp-infra && npm run check:gcp-workflow && npm run check:gcp-model-parity && npm run typecheck:gcp && npm run test:gcp && npm run build:gcp"
  },
