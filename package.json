    "node": ">=22.22.0"
  },
  "scripts": {
    "build:gcp": "tsc -p tsconfig.gcp.build.json",
    "check:gcp-infra": "tofu -chdir=gcp/infra fmt -check -recursive && tofu -chdir=gcp/infra validate",
    "check:gcp-local-boundary": "node gcp/scripts/check-local-boundary.mjs",
    "check:gcp-model-parity": "node scripts/check-gcp-model-parity.mjs",
    "check:gcp-workflow": "node gcp/scripts/check-workflow-parity.mjs",
    "inventory:gcp-source": "node gcp/scripts/capture-source-inventory.mjs",
    "inventory:gcp-database": "node gcp/scripts/capture-source-inventory.mjs",
    "inventory:gcp-source-manifests": "npm run build:gcp && node gcp/scripts/capture-source-manifests.mjs",
    "migrate:gcp-storage": "npm run build:gcp && node gcp/scripts/migrate-storage.mjs",
    "migrate:gcp-database": "npm run build:gcp && node gcp/scripts/migrate-database.mjs",
    "plan:gcp-database-archive": "npm run build:gcp && node gcp/scripts/generate-database-archive-plan.mjs",
    "plan:gcp-database-canonical": "npm run build:gcp && node gcp/scripts/generate-database-canonical-plan.mjs",
