main:
  params: [args]
  steps:
    - validate:
        switch:
          - condition: $${not("runId" in args)}
            raise: "runId is required"
    - accessInternalToken:
        call: googleapis.secretmanager.v1.projects.secrets.versions.accessString
        args:
          project_id: "${project_id}"
          secret_id: "${internal_secret_id}"
          version: "latest"
        result: internalToken
    - intake:
        call: runStage
        args: { internalToken: $${internalToken}, runId: $${args.runId}, stageId: "intake" }
    - gscPromotion:
        call: runStage
        args: { internalToken: $${internalToken}, runId: $${args.runId}, stageId: "gsc-promotion" }
    - detox:
        call: runStage
        args: { internalToken: $${internalToken}, runId: $${args.runId}, stageId: "detox" }
    - preflight:
        call: runStage
        args: { internalToken: $${internalToken}, runId: $${args.runId}, stageId: "preflight" }
    - keywordEnrichment:
        call: runStage
        args: { internalToken: $${internalToken}, runId: $${args.runId}, stageId: "keyword-enrichment" }
    - clustering:
        call: runStage
        args: { internalToken: $${internalToken}, runId: $${args.runId}, stageId: "clustering" }
    - parallelTracks:
        parallel:
          exception_policy: continueAll
          branches:
            - categorisationTrack:
                steps:
                  - categorisation:
                      call: runStage
                      args: { internalToken: $${internalToken}, runId: $${args.runId}, stageId: "categorisation" }
            - forecastTrack:
                steps:
                  - calculationTracks:
                      parallel:
                        exception_policy: continueAll
                        branches:
                          - ctrTruthTrack:
                              steps:
                                - brandClassification:
                                    call: runStage
                                    args: { internalToken: $${internalToken}, runId: $${args.runId}, stageId: "brand-classification" }
                                - gscIntent:
                                    call: runStage
                                    args: { internalToken: $${internalToken}, runId: $${args.runId}, stageId: "gsc-intent" }
                                - ctrCurves:
                                    call: runStage
                                    args: { internalToken: $${internalToken}, runId: $${args.runId}, stageId: "ctr-curves" }
                          - demandTrack:
                              steps:
                                - historicalVolume:
                                    call: runStage
                                    args: { internalToken: $${internalToken}, runId: $${args.runId}, stageId: "historical-volume" }
                                - demandSignals:
                                    call: runStage
                                    args: { internalToken: $${internalToken}, runId: $${args.runId}, stageId: "demand-signals" }
                          - competitiveTrack:
                              steps:
                                - serpCollection:
                                    call: runStage
                                    args: { internalToken: $${internalToken}, runId: $${args.runId}, stageId: "serp-collection" }
                                - authority:
                                    call: runStage
                                    args: { internalToken: $${internalToken}, runId: $${args.runId}, stageId: "authority" }
                                - backlinks:
                                    call: runStage
                                    args: { internalToken: $${internalToken}, runId: $${args.runId}, stageId: "backlinks" }
                                - linkPowerScore:
                                    call: runStage
                                    args: { internalToken: $${internalToken}, runId: $${args.runId}, stageId: "link-power-score" }
                          - contentTrack:
                              steps:
                                - rankingUrl:
                                    call: runStage
                                    args: { internalToken: $${internalToken}, runId: $${args.runId}, stageId: "ranking-url" }
                                - siteArchitecture:
                                    call: runStage
                                    args: { internalToken: $${internalToken}, runId: $${args.runId}, stageId: "site-architecture" }
                  - harReadiness:
                      call: runStage
                      args: { internalToken: $${internalToken}, runId: $${args.runId}, stageId: "har-readiness" }
                  - harV2:
                      call: runStage
                      args: { internalToken: $${internalToken}, runId: $${args.runId}, stageId: "har-v2" }
                  - revenueReadiness:
                      call: runStage
                      args: { internalToken: $${internalToken}, runId: $${args.runId}, stageId: "revenue-readiness" }
                  - revenueV2:
                      call: runStage
                      args: { internalToken: $${internalToken}, runId: $${args.runId}, stageId: "revenue-v2" }
                  - calibration:
                      call: runStage
                      args: { internalToken: $${internalToken}, runId: $${args.runId}, stageId: "calibration" }
    - rollupOutput:
        call: runStage
        args: { internalToken: $${internalToken}, runId: $${args.runId}, stageId: "rollup-output" }
    - complete:
        return:
          runId: $${args.runId}
          stageCount: 24
          status: "succeeded"

runStage:
  params: [internalToken, runId, stageId]
  steps:
    - deliver:
        try:
          call: http.post
          args:
            url: "${worker_url}/internal/tasks"
            timeout: 900
            auth:
              type: OIDC
              audience: "${worker_url}"
            headers:
              Content-Type: "application/json"
              X-Seer-Internal-Token: $${internalToken}
            body:
              runId: $${runId}
              stageId: $${stageId}
              taskId: $${runId + ":" + stageId}
          result: stageResponse
        retry:
          predicate: $${http.default_retry_predicate}
          max_retries: 5
          backoff:
            initial_delay: 1
            max_delay: 60
            multiplier: 2
        except:
          as: stageError
          steps:
            - recordFailure:
                try:
                  call: http.post
                  args:
                    url: "${worker_url}/internal/failures"
                    timeout: 30
                    auth:
                      type: OIDC
                      audience: "${worker_url}"
                    headers:
                      Content-Type: "application/json"
                      X-Seer-Internal-Token: $${internalToken}
                    body:
                      reason: $${json.encode_to_string(stageError)}
                      runId: $${runId}
                      stageId: $${stageId}
                except:
                  as: failureRecordError
                  steps:
                    - logFailureRecordError:
                        call: sys.log
                        args:
                          severity: "ERROR"
                          text: '$${"Could not persist pipeline failure: " + json.encode_to_string(failureRecordError)}'
            - raiseFailure:
                raise: $${stageError}
    - complete:
        return: $${stageResponse.body}
